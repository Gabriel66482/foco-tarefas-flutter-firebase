{
  "rules": {
    ".read": false,
    ".write": false,
    "usuarios": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "tarefas": {
          "$id": {
            ".validate": "newData.hasChildren(['titulo', 'descricao', 'dataVencimento', 'prioridade', 'concluida'])",
            "titulo": {".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 120"},
            "descricao": {".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 2000"},
            "dataVencimento": {".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)"},
            "prioridade": {".validate": "newData.val() === 'baixa' || newData.val() === 'media' || newData.val() === 'alta'"},
            "concluida": {".validate": "newData.isBoolean()"},
            "$other": {".validate": false}
          }
        },
        "$other": {".validate": false}
      }
    }
  }
}
