{
  "name": "foco-tarefas-firebase-tests",
  "private": true,
  "scripts": {
    "emulators": "firebase emulators:start --project demo-foco-tarefas --import=.firebase-data --export-on-exit=.firebase-data",
    "test:rules": "firebase emulators:exec --project demo-foco-tarefas --only auth,database \"node --test tests/database.rules.test.cjs\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "firebase": "13.2.0",
    "firebase-tools": "15.35.0"
  }
}
